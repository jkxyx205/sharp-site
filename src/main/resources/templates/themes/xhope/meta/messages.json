  "p.sweeper.eyebrow":   { "en-US": "ROBOT SWEEPER", "zh-CN": "扫地机" },
  "p.sweeper.name":      { "en-US": "XHOPE S9 AutoMap", "zh-CN": "XHOPE S9 自图" },
  "p.sweeper.tag":       { "en-US": "Autonomous sweep", "zh-CN": "自主清扫" },
  "p.sweeper.lead":      { "en-US": "Maps your home in 6 minutes with a solid-state lidar, then cleans in efficient overlapping passes. A self-emptying base holds up to 60 days of dust — you forget it is there until the bag is full.", "zh-CN": "固态激光雷达 6 分钟建图，按高效重叠路径清扫。自集尘座可容纳长达 60 天的灰尘——直到尘袋满，你才会想起它的存在。" },
  "p.sweeper.f1": { "en-US": "Navigation", "zh-CN": "导航" }, "p.sweeper.v1": { "en-US": "Solid-state LiDAR", "zh-CN": "固态激光雷达" },
  "p.sweeper.f2": { "en-US": "Suction", "zh-CN": "吸力" }, "p.sweeper.v2": { "en-US": "8,000 Pa", "zh-CN": "8,000 Pa" },
  "p.sweeper.f3": { "en-US": "Self-empty", "zh-CN": "自集尘" }, "p.sweeper.v3": { "en-US": "Up to 60 days", "zh-CN": "最长 60 天" },
  "p.sweeper.f4": { "en-US": "Runtime", "zh-CN": "续航" }, "p.sweeper.v4": { "en-US": "240 min", "zh-CN": "240 分钟" },
  "p.sweeper.f5": { "en-US": "Obstacle clear", "zh-CN": "越障" }, "p.sweeper.v5": { "en-US": "22 mm", "zh-CN": "22 mm" },

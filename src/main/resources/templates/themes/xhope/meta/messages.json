  "p.fabric.f4": { "en-US": "Dirty tank", "zh-CN": "污水箱" }, "p.fabric.v4": { "en-US": "1.6 L", "zh-CN": "1.6 L" },
  "p.fabric.f5": { "en-US": "Brush width", "zh-CN": "刷头宽度" }, "p.fabric.v5": { "en-US": "240 mm", "zh-CN": "240 mm" },

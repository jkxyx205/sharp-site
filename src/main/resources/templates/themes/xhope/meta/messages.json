  "p.vacuum.eyebrow":   { "en-US": "CORDLESS VACUUM", "zh-CN": "无线吸尘器" },
  "p.vacuum.name":      { "en-US": "XHOPE V9 Cyclone", "zh-CN": "XHOPE V9 旋风" },
  "p.vacuum.tag":       { "en-US": "Flagship cordless", "zh-CN": "旗舰无线" },
  "p.vacuum.lead":      { "en-US": "A whole-home deep clean in a body that weighs less than a bag of flour. 300 AW of suction, a full-color LCD, and a 60-minute battery that swaps in seconds.", "zh-CN": "整机轻于一袋面粉，却能完成全屋深度清洁。300 AW 吸力、全彩 LCD、60 分钟可快换电池。" },
  "p.vacuum.f1": { "en-US": "Suction power", "zh-CN": "吸入功率" }, "p.vacuum.v1": { "en-US": "300 AW", "zh-CN": "300 AW" },

  "p.fabric.eyebrow":   { "en-US": "FABRIC CLEANER", "zh-CN": "布艺清洗机" },
  "p.fabric.name":      { "en-US": "XHOPE F7 DeepLift", "zh-CN": "XHOPE F7 深净" },
  "p.fabric.tag":       { "en-US": "Stain & upholstery", "zh-CN": "软装深净" },
  "p.fabric.lead":      { "en-US": "Sofas, mattresses, car interiors, rugs. A high-pressure spray lifts what a surface vacuum never could, then extracts the dirty water in the same pass — fabric dry to the touch in minutes.", "zh-CN": "沙发、床垫、车饰、地毯。高压喷淋掀起表层吸尘器无法触及的污渍，同一行程回收污水——几分钟即可触干。" },
  "p.fabric.f1": { "en-US": "Spray pressure", "zh-CN": "喷淋压力" }, "p.fabric.v1": { "en-US": "1.2 MPa", "zh-CN": "1.2 MPa" },
